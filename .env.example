APP_NAME=Story AI Backend
# 运行环境：生产服务器请改为 production，并关闭 APP_DEBUG。
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Uvicorn 对外监听由 systemd service 读取。
# 4 核 16G 高并发配置：API 服务 2 workers，把更多 CPU 留给 Celery 外部 API 任务。
WEB_HOST=127.0.0.1
WEB_PORT=8081
WEB_WORKERS=2

API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# 仅这些直连反向代理可以提供 X-Forwarded-For；支持单个 IP 或 CIDR。
TRUSTED_PROXY_IPS=["127.0.0.1","::1"]

TIMEZONE=Asia/Shanghai

JWT_SECRET_KEY=please-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEFAULT_USER_AVATAR=https://wpimg.wallstcn.com/f778738c-e4f8-4870-b634-56703b4acafe.gif
ENFORCE_PRODUCTION_CONFIG=true

# 日志配置。
# 主日志和错误日志为 JSON Lines，访问日志记录 HTTP 请求；管理端可按 app/access/error 查看。
LOG_DIR=logs
LOG_FILE=story-ai.log
LOG_ACCESS_FILE=access.log
LOG_ERROR_FILE=error.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_SQL_ENABLED=false

# 模型服务 HTTP 连接池。
# 当前文本、图像、视频都调用外部 API 模型，4 核 16G 可使用 100 连接上限。
# 如果外部接口频繁返回限流/繁忙，再把最大连接调回 80。
COMFLY_BASE_URL=
COMFLY_API_KEY=
COMFLY_TIMEOUT_SECONDS=30
COMFLY_MAX_CONNECTIONS=100
COMFLY_MAX_KEEPALIVE_CONNECTIONS=30

# 备用模型服务 HTTP 连接池。
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_TIMEOUT_SECONDS=30
VOLCENGINE_ARK_MAX_CONNECTIONS=100
VOLCENGINE_ARK_MAX_KEEPALIVE_CONNECTIONS=30

# PostgreSQL 连接池。
# 当前拆成 API + 4 个 Celery worker 服务，单进程连接池不要过大。
# 数据库连接上限 100 时推荐 2 + 2。
# API 2 workers + Celery 44 并发时，理论连接上限较高，需要给数据库保留足够连接余量。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=story_ai
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800

# Redis 同时用于限流、Celery broker 和任务结果。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

CELERY_BROKER_DB=1
CELERY_RESULT_DB=2

# OSS/对象存储配置。
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
OSS_ROOT_DIRECTORY=story
# 私有 OSS 媒体临时访问地址有效期，默认 10 分钟。
OSS_SIGNED_URL_EXPIRES_SECONDS=600
MAX_UPLOAD_SIZE_MB=300
# 单个用户的作品媒体总存储上限；设为 0 表示不限制。
USER_WORK_STORAGE_LIMIT_MB=2048
# 未被作品引用的暂存文件超过此时长后自动清理；设为 0 表示关闭清理。
UNUSED_WORK_UPLOAD_TTL_HOURS=24

ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_REGISTER_TEMPLATE_CODE=
ALIYUN_SMS_REGISTER_TEMPLATE_PARAM_KEY=code
ALIYUN_SMS_CODE_TTL_SECONDS=300
ALIYUN_SMS_SEND_INTERVAL_SECONDS=60
ALIYUN_SMS_MAX_VERIFY_ATTEMPTS=5
ALIYUN_SMS_MOCK_ENABLED=false

# 微信支付 Native 扫码支付配置
# 网页端只需要后端生成 code_url，前端把 code_url 渲染成二维码。
# AppID：填写已绑定当前商户号的小程序/公众号/App 的 AppID。
WECHAT_PAY_APPID=
# 商户号：微信商户平台的 mchid，通常是纯数字。
WECHAT_PAY_MCHID=
# APIv3 密钥：微信商户平台「API 安全」中设置的 32 位密钥。
WECHAT_PAY_API_V3_KEY=
# 商户 API 证书序列号：不是平台证书序列号，可用 openssl 查看 apiclient_cert.pem。
WECHAT_PAY_MERCHANT_SERIAL_NO=
# 商户 API 证书文件：用于本地校验序列号和私钥是否匹配，不参与下单请求。
WECHAT_PAY_MERCHANT_CERT_PATH=key/apiclient_cert.pem
# 商户私钥文件路径：微信商户平台下载证书包中的 apiclient_key.pem。
WECHAT_PAY_PRIVATE_KEY_PATH=key/apiclient_key.pem
# 微信支付平台证书文件路径：用于验签微信支付回调，不是商户证书。
WECHAT_PAY_PLATFORM_CERT_PATH=key/wechatpay_platform.pem
# 支付成功回调地址：必须是公网 HTTPS，微信支付服务器能够访问。
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/v1/points/wechat/notify
# 微信支付 HTTP 请求超时时间，默认 30 秒即可。
WECHAT_PAY_TIMEOUT_SECONDS=30
WECHAT_PAY_NOTIFY_TOLERANCE_SECONDS=300
# Native 二维码有效期，默认 30 分钟。
WECHAT_PAY_NATIVE_EXPIRE_MINUTES=30
# 本地调试可临时设为 true，生产必须为 false。
WECHAT_PAY_MOCK_ENABLED=false

# API 限流配置。
# 4 核 16G + 外部 API 模型推荐下面这组数值；如果出现大量轮询 429，可优先调高 RATE_LIMIT_POLLING_REQUESTS。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_REQUESTS=900
RATE_LIMIT_AUTH_REQUESTS=30
RATE_LIMIT_UPLOAD_REQUESTS=30
RATE_LIMIT_GENERATION_REQUESTS=180
RATE_LIMIT_POLLING_REQUESTS=300

# Celery 通用任务参数。
# time_limit 是硬超时，soft_time_limit 是优雅超时，任务超过后会进入失败/退款流程。
# 实际运行时会自动保证 soft_time_limit >= 外部模型 HTTP 超时 + CELERY_TASK_TIMEOUT_GRACE_SECONDS，
# time_limit >= 实际 soft_time_limit + CELERY_TASK_TIMEOUT_GRACE_SECONDS，避免模型请求还没超时就先被 Celery 信号打断。
CELERY_TASK_TIME_LIMIT_SECONDS=300
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=240
CELERY_TASK_TIMEOUT_GRACE_SECONDS=60
CELERY_TASK_MAX_RETRIES=5
CELERY_TASK_RETRY_COUNTDOWN_SECONDS=30
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=300
CELERY_RESULT_EXPIRES_SECONDS=86400

# 默认/兼容 worker：只处理历史 celery 队列和默认队列。
# 不承载文本、图像、视频主任务，避免旧任务和兜底任务影响主队列。
CELERY_WORKER_MAX_TASKS_PER_CHILD=50
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_QUEUES=celery,story_ai_default
CELERY_WORKER_MAX_MEMORY_PER_CHILD=700000

# 文本 worker：处理对话文本、章节处理、资源分析、分镜分析。
# 外部 API 模型场景推荐并发 16；如果外部接口限流明显，可适当下调。
CELERY_TEXT_WORKER_CONCURRENCY=16
CELERY_TEXT_WORKER_QUEUES=story_ai_text
CELERY_TEXT_WORKER_MAX_TASKS_PER_CHILD=50
CELERY_TEXT_WORKER_MAX_MEMORY_PER_CHILD=700000

# 图像 worker：处理图像生成和图像结果转存。
# 图像任务调用外部 API，高并发配置为 16；如果转存带宽吃紧可适当下调。
CELERY_IMAGE_WORKER_CONCURRENCY=16
CELERY_IMAGE_WORKER_QUEUES=story_ai_image
CELERY_IMAGE_WORKER_MAX_TASKS_PER_CHILD=40
CELERY_IMAGE_WORKER_MAX_MEMORY_PER_CHILD=1200000

# 视频 worker：处理视频生成和视频结果转存。
# 视频任务调用外部 API，但视频下载和转存压力更大，推荐并发 10。
CELERY_VIDEO_WORKER_CONCURRENCY=10
CELERY_VIDEO_WORKER_QUEUES=story_ai_video
CELERY_VIDEO_WORKER_MAX_TASKS_PER_CHILD=30
CELERY_VIDEO_WORKER_MAX_MEMORY_PER_CHILD=1200000

# 模型二级任务查询配置。
# 媒体任务通常不会秒级完成，worker 拿到厂商 task_id 后默认不原地等待，交给延迟 reconcile 查询。
PROVIDER_TASK_POLL_INTERVAL_SECONDS=30
PROVIDER_TASK_IMAGE_POLL_INTERVAL_SECONDS=60
PROVIDER_TASK_VIDEO_POLL_INTERVAL_SECONDS=120
PROVIDER_TASK_POLL_MAX_ATTEMPTS=60
PROVIDER_TASK_WORKER_POLL_INTERVAL_SECONDS=5
PROVIDER_TASK_WORKER_POLL_MAX_ATTEMPTS=0

# 单用户待处理任务统计窗口。
# 达到下面任一上限时，任务提交接口返回 HTTP 429。
USER_PENDING_TASK_LIMIT=40
USER_PENDING_MEDIA_TASK_LIMIT=12
USER_PENDING_TASK_WINDOW_HOURS=24

# 整剧 Agent 单个原始剧本的最大字符数。
AGENT_SOURCE_MAX_CHARACTERS=100000
AGENT_SOURCE_MAX_FILE_SIZE_MB=20
AGENT_SOURCE_CHUNK_CHARACTERS=12000
AGENT_SOURCE_PARSE_TIMEOUT_SECONDS=30
AGENT_SOURCE_PARSE_CONCURRENCY=2

# 超时兜底：未取得第三方 task_id 的本地任务超时后判定失败并退回积分。
# 已取得 task_id 的任务由 Celery reconcile/Beat 持续回收，不使用此超时退款。
TASK_STALE_TIMEOUT_MINUTES=30

# 生成媒体转存配置。
# Celery 总并发 44 时推荐转存并发 8；如果带宽或对象存储响应慢，可调低到 4。
GENERATED_MEDIA_DOWNLOAD_MAX_SIZE_MB=500
GENERATED_MEDIA_TRANSFER_CONCURRENCY=8
GENERATED_MEDIA_CONNECT_TIMEOUT_SECONDS=30
GENERATED_MEDIA_READ_TIMEOUT_SECONDS=300
GENERATED_MEDIA_UPLOAD_TIMEOUT_SECONDS=120
