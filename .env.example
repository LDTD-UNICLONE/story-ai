APP_NAME=Story AI Backend
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

TIMEZONE=Asia/Shanghai

JWT_SECRET_KEY=please-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEFAULT_USER_AVATAR=https://wpimg.wallstcn.com/f778738c-e4f8-4870-b634-56703b4acafe.gif
ENFORCE_PRODUCTION_CONFIG=true

COMFLY_BASE_URL=
COMFLY_API_KEY=
COMFLY_TIMEOUT_SECONDS=30
COMFLY_MAX_CONNECTIONS=100
COMFLY_MAX_KEEPALIVE_CONNECTIONS=20

VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_TIMEOUT_SECONDS=30
VOLCENGINE_ARK_MAX_CONNECTIONS=100
VOLCENGINE_ARK_MAX_KEEPALIVE_CONNECTIONS=20

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=story_ai
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

CELERY_BROKER_DB=1
CELERY_RESULT_DB=2
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
OSS_ROOT_DIRECTORY=story
MAX_UPLOAD_SIZE_MB=100

ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_REGISTER_TEMPLATE_CODE=
ALIYUN_SMS_REGISTER_TEMPLATE_PARAM_KEY=code
ALIYUN_SMS_CODE_TTL_SECONDS=300
ALIYUN_SMS_SEND_INTERVAL_SECONDS=60
ALIYUN_SMS_MOCK_ENABLED=false

# 微信支付 Native 扫码支付配置
# 网页端只需要后端生成 code_url，前端把 code_url 渲染成二维码。
# AppID：填写已绑定当前商户号的小程序/公众号/App 的 AppID。
WECHAT_PAY_APPID=
# 商户号：微信商户平台的 mchid，通常是纯数字。
WECHAT_PAY_MCHID=
# APIv3 密钥：微信商户平台「API 安全」中设置的 32 位密钥。
WECHAT_PAY_API_V3_KEY=
# 商户 API 证书序列号：不是平台证书序列号，可用 openssl 查看 apiclient_cert.pem。
WECHAT_PAY_MERCHANT_SERIAL_NO=
# 商户 API 证书文件：用于本地校验序列号和私钥是否匹配，不参与下单请求。
WECHAT_PAY_MERCHANT_CERT_PATH=key/apiclient_cert.pem
# 商户私钥文件路径：微信商户平台下载证书包中的 apiclient_key.pem。
WECHAT_PAY_PRIVATE_KEY_PATH=key/apiclient_key.pem
# 微信支付平台证书文件路径：用于验签微信支付回调，不是商户证书。
WECHAT_PAY_PLATFORM_CERT_PATH=key/wechatpay_platform.pem
# 支付成功回调地址：必须是公网 HTTPS，微信支付服务器能够访问。
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/v1/points/wechat/notify
# 微信支付 HTTP 请求超时时间，默认 30 秒即可。
WECHAT_PAY_TIMEOUT_SECONDS=30
# Native 二维码有效期，默认 120 分钟。
WECHAT_PAY_NATIVE_EXPIRE_MINUTES=120
# 本地调试可临时设为 true，生产必须为 false。
WECHAT_PAY_MOCK_ENABLED=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_REQUESTS=300
RATE_LIMIT_AUTH_REQUESTS=30
RATE_LIMIT_UPLOAD_REQUESTS=30
RATE_LIMIT_GENERATION_REQUESTS=60
RATE_LIMIT_POLLING_REQUESTS=60

CELERY_TASK_TIME_LIMIT_SECONDS=300
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=240
CELERY_TASK_MAX_RETRIES=5
CELERY_TASK_RETRY_COUNTDOWN_SECONDS=30
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=300
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_WORKER_MAX_TASKS_PER_CHILD=50
CELERY_WORKER_CONCURRENCY=2

PROVIDER_TASK_POLL_INTERVAL_SECONDS=10
PROVIDER_TASK_POLL_MAX_ATTEMPTS=60
PROVIDER_TASK_WORKER_POLL_INTERVAL_SECONDS=5
PROVIDER_TASK_WORKER_POLL_MAX_ATTEMPTS=3
USER_PENDING_TASK_LIMIT=20
USER_PENDING_MEDIA_TASK_LIMIT=5
USER_PENDING_TASK_WINDOW_HOURS=24
TASK_STALE_TIMEOUT_MINUTES=30
GENERATED_MEDIA_DOWNLOAD_MAX_SIZE_MB=500
GENERATED_MEDIA_TRANSFER_CONCURRENCY=3
GENERATED_MEDIA_CONNECT_TIMEOUT_SECONDS=30
GENERATED_MEDIA_READ_TIMEOUT_SECONDS=300
